sqlite3 -cmd ".headers on" -cmd ".mode column" $1/results.db "SELECT s.uuid AS session_uuid, datetime(s.session_start_unix, 'unixepoch') AS start_time, datetime(s.session_end_unix, 'unixepoch') AS end_time, json_extract(s.json_blob, '$.session_info.user') AS username, json_extract(s.json_blob, '$.session_info.hostname') AS hostname, json_extract(s.json_blob, '$.session_info.system') AS system_name, COUNT(t.uuid) AS testcase_count FROM sessions s LEFT JOIN testcases t ON s.uuid = t.session_uuid GROUP BY s.uuid ORDER BY start_time DESC;"
